      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Quantum Computing RAG Pipeline Evaluation with LangSmith & LLM-as-a-Judge\n",
        "\n",
        "This notebook evaluates our modular FAISS + Groq RAG pipeline using LangSmith and LLM-as-a-judge.\n",
        "It follows the exact structure and metrics from the reference evaluation notebook (`1-rag_evaluation.ipynb`):\n",
        "\n",
        "1. **Answer Correctness**: Assesses factual accuracy against ground truth answers.\n",
        "2. **Answer Relevance**: Checks whether the response directly addresses the user question.\n",
        "3. **Groundedness / Faithfulness**: Verifies zero hallucinations beyond retrieved context documents.\n",
        "4. **Retrieval Relevance**: Ensures retrieved document chunks are relevant to the query."
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 1. Setup & Environment Variables"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import os\n",
        "import sys\n",
        "import time\n",
        "from dotenv import load_dotenv\n",
        "\n",
        "load_dotenv()\n",
        "\n",
        "# Set LangSmith environment\n",
        "langsmith_key = os.getenv(\"LANGSMITH_API_KEY\") or os.getenv(\"LANGSMith_API_KEY\")\n",
        "if langsmith_key:\n",
        "    os.environ[\"LANGSMITH_API_KEY\"] = langsmith_key\n",
        "\n",
        "langsmith_endpoint = os.getenv(\"LANGSMITH_ENDPOINT\", \"https://eu.api.smith.langchain.com\")\n",
        "os.environ[\"LANGSMITH_ENDPOINT\"] = langsmith_endpoint\n",
        "os.environ[\"LANGSMITH_TRACING\"] = \"true\"\n",
        "\n",
        "# Add src directory to path\n",
        "if \"src\" not in sys.path:\n",
        "    sys.path.append(os.path.abspath(\"src\"))\n",
        "\n",
        "from langsmith import Client\n",
        "client = Client(api_url=langsmith_endpoint, api_key=langsmith_key)\n",
        "try:\n",
        "    list(client.list_datasets(limit=1))\n",
        "    print(f\"Connected to LangSmith successfully ({langsmith_endpoint}).\")\n",
        "except Exception as e:\n",
        "    print(f\"Notice: LangSmith connection status: {e}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 2. Test Dataset (Quantum Computing Benchmark)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "dataset_name = \"Quantum RAG Evaluation\"\n",
        "\n",
        "examples = [\n",
        "    {\n",
        "        \"inputs\": {\"question\": \"What is a qubit in quantum computing?\"},\n",
        "        \"outputs\": {\"answer\": \"A qubit is the fundamental unit of quantum information, analogous to a classical bit, which can exist in a superposition of states |0> and |1> in a two-dimensional Hilbert space.\"}\n",
        "    },\n",
        "    {\n",
        "        \"inputs\": {\"question\": \"What is the no-cloning theorem?\"},\n",
        "        \"outputs\": {\"answer\": \"The no-cloning theorem states that it is impossible to create an identical copy of an arbitrary unknown quantum state.\"}\n",
        "    },\n",
        "    {\n",
        "        \"inputs\": {\"question\": \"How does an n-qubit quantum system scale in Hilbert space size?\"},\n",
        "        \"outputs\": {\"answer\": \"An n-qubit quantum system has access to a Hilbert space of dimension 2^n, enabling exponential state representations compared to classical bits.\"}\n",
        "    },\n",
        "    {\n",
        "        \"inputs\": {\"question\": \"What are Variational Quantum Eigensolvers used for?\"},\n",
        "        \"outputs\": {\"answer\": \"Variational Quantum Eigensolvers are hybrid quantum-classical algorithms that use parameterized quantum circuits and classical optimization to find the ground state energy of quantum systems.\"}\n",
        "    },\n",
        "    {\n",
        "        \"inputs\": {\"question\": \"What is quantum decoherence?\"},\n",
        "        \"outputs\": {\"answer\": \"Quantum decoherence is the decay of quantum superposition into classical states caused by environmental interaction and noise.\"}\n",
        "    }\n",
        "]\n",
        "\n",
        "use_langsmith = False\n",
        "try:\n",
        "    existing_datasets = list(client.list_datasets(dataset_name=dataset_name))\n",
        "    if existing_datasets:\n",
        "        dataset = existing_datasets[0]\n",
        "        print(f\"Found existing LangSmith cloud dataset: {dataset.name} (id: {dataset.id})\")\n",
        "    else:\n",
        "        dataset = client.create_dataset(dataset_name=dataset_name)\n",
        "        client.create_examples(dataset_id=dataset.id, examples=examples)\n",
        "        print(f\"Created LangSmith cloud dataset '{dataset_name}' with {len(examples)} examples.\")\n",
        "    use_langsmith = True\n",
        "except Exception as e:\n",
        "    print(f\"Notice: LangSmith cloud dataset sync skipped ({e}).\")\n",
        "    print(\"Continuing with local benchmark dataset (5 test cases) for evaluation.\")\n",
        "    dataset = examples"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 3. Define Metrics (LLM As A Judge with Structured Outputs)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from typing import Any, Optional\n",
        "from typing_extensions import Annotated, TypedDict\n",
        "from langchain_groq import ChatGroq\n",
        "\n",
        "# Schemas matching 1-rag_evaluation.ipynb\n",
        "class CorrectnessGrade(TypedDict):\n",
        "    explanation: Annotated[str, ..., \"Explain your reasoning for the score\"]\n",
        "    correct: Annotated[bool, ..., \"True if the answer is correct, False otherwise.\"]\n",
        "\n",
        "class RelevanceGrade(TypedDict):\n",
        "    explanation: Annotated[str, ..., \"Explain your reasoning for the score\"]\n",
        "    relevant: Annotated[bool, ..., \"Provide the score on whether the answer addresses the question\"]\n",
        "\n",
        "class GroundedGrade(TypedDict):\n",
        "    explanation: Annotated[str, ..., \"Explain your reasoning for the score\"]\n",
        "    grounded: Annotated[bool, ..., \"Provide the score on if the answer hallucinates from the documents\"]\n",
        "\n",
        "class RetrievalRelevanceGrade(TypedDict):\n",
        "    explanation: Annotated[str, ..., \"Explain your reasoning for the score\"]\n",
        "    relevant: Annotated[bool, ..., \"True if the retrieved documents are relevant to the question, False otherwise\"]\n",
        "\n",
        "# Instructions matching 1-rag_evaluation.ipynb\n",
        "correctness_instructions = \"\"\"You are a teacher grading a quiz.\n",
        "You will be given a QUESTION, the GROUND TRUTH (correct) ANSWER, and the STUDENT ANSWER.\n",
        "Grade the student answers based ONLY on their factual accuracy relative to the ground truth answer.\n",
        "Respond with explanation and correct boolean.\"\"\"\n",
        "\n",
        "relevance_instructions = \"\"\"You are a teacher grading a quiz.\n",
        "You will be given a QUESTION and a STUDENT ANSWER.\n",
        "Ensure the STUDENT ANSWER is concise, relevant, and helps answer the QUESTION.\"\"\"\n",
        "\n",
        "grounded_instructions = \"\"\"You are a teacher grading a quiz.\n",
        "You will be given FACTS and a STUDENT ANSWER.\n",
        "Ensure the STUDENT ANSWER is grounded in the FACTS and does not contain hallucinated information.\"\"\"\n",
        "\n",
        "retrieval_relevance_instructions = \"\"\"You are a teacher grading a quiz.\n",
        "You will be given a QUESTION and a set of FACTS provided by the student.\n",
        "Identify if the facts contain ANY keywords or semantic meaning related to the question.\"\"\"\n",
        "\n",
        "groq_api_key = os.getenv(\"GROQ_API_KEY\")\n",
        "grader_llm = ChatGroq(groq_api_key=groq_api_key, model_name=\"openai/gpt-oss-20b\", temperature=0)\n",
        "print(\"Grader LLM initialized (openai/gpt-oss-20b).\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 4. Evaluator Functions with Rate-Limit Resilience"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import re\n",
        "\n",
        "correctness_grader = grader_llm.with_structured_output(CorrectnessGrade)\n",
        "relevance_grader = grader_llm.with_structured_output(RelevanceGrade)\n",
        "grounded_grader = grader_llm.with_structured_output(GroundedGrade)\n",
        "retrieval_grader = grader_llm.with_structured_output(RetrievalRelevanceGrade)\n",
        "\n",
        "def safe_invoke(runnable, messages, max_retries=5, initial_delay=2.0, target_field=None):\n",
        "    delay = initial_delay\n",
        "    for attempt in range(max_retries):\n",
        "        try:\n",
        "            return runnable.invoke(messages)\n",
        "        except Exception as e:\n",
        "            err_str = str(e)\n",
        "            if \"rate limit\" in err_str.lower() or \"429\" in err_str or \"tpm\" in err_str.lower():\n",
        "                wait = delay + attempt * 2\n",
        "                print(f\"  [Rate limit reached, pausing {wait:.1f}s before retry...]\")\n",
        "                time.sleep(wait)\n",
        "                delay *= 1.5\n",
        "            elif \"tool_use_failed\" in err_str or \"failed to parse tool call arguments\" in err_str.lower():\n",
        "                if target_field:\n",
        "                    pattern = rf'[\"\\\']?{target_field}[\"\\\']?\\s*:\\s*(true|false)'\n",
        "                    m = re.search(pattern, err_str, re.IGNORECASE)\n",
        "                    if m:\n",
        "                        val = m.group(1).lower() == \"true\"\n",
        "                        return {target_field: val, \"explanation\": \"Extracted from output.\"}\n",
        "                raise e\n",
        "            else:\n",
        "                raise e\n",
        "    return runnable.invoke(messages)\n",
        "\n",
        "def _extract_field(result: Any, field_name: str, default: bool = False) -> bool:\n",
        "    if isinstance(result, dict):\n",
        "        return bool(result.get(field_name, default))\n",
        "    return bool(getattr(result, field_name, default))\n",
        "\n",
        "def correctness(inputs: dict, outputs: dict, reference_outputs: dict) -> bool:\n",
        "    answers = f\"QUESTION: {inputs['question']}\\nGROUND TRUTH ANSWER: {reference_outputs['answer']}\\nSTUDENT ANSWER: {outputs['answer']}\"\n",
        "    grade = safe_invoke(correctness_grader, [\n",
        "        {\"role\": \"system\", \"content\": correctness_instructions},\n",
        "        {\"role\": \"user\", \"content\": answers}\n",
        "    ], target_field=\"correct\")\n",
        "    return _extract_field(grade, \"correct\")\n",
        "\n",
        "def relevance(inputs: dict, outputs: dict) -> bool:\n",
        "    answer = f\"QUESTION: {inputs['question']}\\nSTUDENT ANSWER: {outputs['answer']}\"\n",
        "    grade = safe_invoke(relevance_grader, [\n",
        "        {\"role\": \"system\", \"content\": relevance_instructions},\n",
        "        {\"role\": \"user\", \"content\": answer}\n",
        "    ], target_field=\"relevant\")\n",
        "    return _extract_field(grade, \"relevant\")\n",
        "\n",
        "def groundedness(inputs: dict, outputs: dict) -> bool:\n",
        "    docs = outputs.get(\"documents\", [])\n",
        "    doc_string = \"\\n\\n\".join(doc.page_content if hasattr(doc, \"page_content\") else str(doc) for doc in docs)\n",
        "    if len(doc_string) > 2500:\n",
        "        doc_string = doc_string[:2500] + \"... [truncated]\"\n",
        "    answer = f\"FACTS: {doc_string}\\nSTUDENT ANSWER: {outputs['answer']}\"\n",
        "    grade = safe_invoke(grounded_grader, [\n",
        "        {\"role\": \"system\", \"content\": grounded_instructions},\n",
        "        {\"role\": \"user\", \"content\": answer}\n",
        "    ], target_field=\"grounded\")\n",
        "    return _extract_field(grade, \"grounded\")\n",
        "\n",
        "def retrieval_relevance(inputs: dict, outputs: dict) -> bool:\n",
        "    docs = outputs.get(\"documents\", [])\n",
        "    doc_string = \"\\n\\n\".join(doc.page_content if hasattr(doc, \"page_content\") else str(doc) for doc in docs)\n",
        "    if len(doc_string) > 2500:\n",
        "        doc_string = doc_string[:2500] + \"... [truncated]\"\n",
        "    answer = f\"FACTS: {doc_string}\\nQUESTION: {inputs['question']}\"\n",
        "    grade = safe_invoke(retrieval_grader, [\n",
        "        {\"role\": \"system\", \"content\": retrieval_relevance_instructions},\n",
        "        {\"role\": \"user\", \"content\": answer}\n",
        "    ], target_field=\"relevant\")\n",
        "    return _extract_field(grade, \"relevant\")\n",
        "\n",
        "print(\"All 4 evaluators registered successfully.\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 5. RAG Pipeline Target Adapter"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from langsmith import traceable\n",
        "try:\n",
        "    from src.search import RAGSearch\n",
        "except ImportError:\n",
        "    from search import RAGSearch\n",
        "\n",
        "rag_search = RAGSearch(persist_dir=\"src/faiss_store\", llm_model=\"openai/gpt-oss-20b\")\n",
        "\n",
        "@traceable(name=\"quantum_rag_pipeline\")\n",
        "def rag_bot(question: str) -> dict:\n",
        "    return rag_search.search_and_retrieve(question, top_k=3, score_threshold=0.45)\n",
        "\n",
        "def target(inputs: dict) -> dict:\n",
        "    return rag_bot(inputs[\"question\"])\n",
        "\n",
        "# Verification test on target adapter\n",
        "sample = target({\"question\": \"What is qubit?\"})\n",
        "print(\"Sample Answer:\", sample[\"answer\"][:120], \"...\")\n",
        "print(\"Retrieved Documents Count:\", len(sample[\"documents\"]))"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 6. Run Evaluation & View Metrics DataFrame"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import pandas as pd\n",
        "\n",
        "df = None\n",
        "if use_langsmith:\n",
        "    try:\n",
        "        print(\"Running cloud evaluation on LangSmith...\")\n",
        "        experiment_results = client.evaluate(\n",
        "            target,\n",
        "            data=dataset_name,\n",
        "            evaluators=[correctness, groundedness, relevance, retrieval_relevance],\n",
        "            experiment_prefix=\"quantum-rag-eval\",\n",
        "            metadata={\"pipeline\": \"FAISS-MiniLM-Groq\"}\n",
        "        )\n",
        "        df = experiment_results.to_pandas()\n",
        "    except Exception as e:\n",
        "        print(f\"Notice: LangSmith cloud evaluate failed ({e}). Running local evaluator fallback...\")\n",
        "\n",
        "if df is None:\n",
        "    try:\n",
        "        from src.evaluation import run_evaluation_local\n",
        "    except ImportError:\n",
        "        from evaluation import run_evaluation_local\n",
        "    df = run_evaluation_local(examples)\n",
        "\n",
        "df"
      ]
    }
